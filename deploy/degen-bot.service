[Unit]
Description=Degen Bot (CFB Parlay Discord Bot)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/degen-bot
EnvironmentFile=/home/pi/degen-bot/.env
ExecStart=/home/pi/degen-bot/.venv/bin/python -m bot.main
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
